METEOFRANCE_API_KEY=
FIRMS_MAP_KEY=
# Alleen server-side gebruikt door /api/assistent (de AI-duider). Zet deze in de
# Vercel-omgevingsvariabelen; hij komt in geen enkele client-bundle voor.
ANTHROPIC_API_KEY=

# Zet op 1 om /api/vigilance/debug te openen. LAAT DIT OP PRODUCTION LEEG:
# die route vertelt of de API-sleutel wordt geaccepteerd en welke status
# Météo-France teruggaf. De route weigert sowieso te werken zodra
# VERCEL_ENV production is, ook mét deze vlag.
VIGILANCE_DEBUG=
